{
  "name": "summeet-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build api-gateway && nest build ai-service && nest build realtime-service",
    "start": "concurrently \"node dist/apps/api-gateway/main.js\" \"node dist/apps/ai-service/main.js\" \"node dist/apps/realtime-service/main.js\"",
    "start:gateway": "nest start api-gateway --watch",
    "start:ai": "nest start ai-service --watch",
    "start:realtime": "nest start realtime-service --watch",
    "dev": "concurrently \"npm run start:gateway\" \"npm run start:ai\" \"npm run start:realtime\""
  },
  "dependencies": {
    "@google/genai": "^1.12.0",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/websockets": "^10.0.0",
    "axios": "^1.16.1",
    "bullmq": "^6.0.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "concurrently": "^9.2.1",
    "franc-all": "^7.2.0",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.0.0",
    "mongoose": "^8.16.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.27",
    "typescript": "^6.0.3"
  }
}
